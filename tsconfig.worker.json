{
  "compilerOptions": {
    "allowJs": false,
    "allowImportingTsExtensions": true,
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2022",
    "types": []
  },
  "include": [
    "worker/**/*.ts",
    "shared/**/*.ts",
    ".cloudflare/types/**/*.d.ts",
    "cloudflare.config.ts"
  ]
}
